@prefix ao: <http://actuarialnotes.com/ontology/actuarial#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Lines of business. skos:notation gives the spellings the wiki uses
# today, so its pages can be mapped onto one list:
#   frontmatter `lob:`            "Auto-Personal"
#   research tables               personal_auto
#   Assumptions `Line:`           free text

ao:PropertyAndCasualty a ao:LineOfBusiness ; rdfs:label "Property and casualty"@en ; skos:notation "P&C" .

ao:Automobile a ao:LineOfBusiness ; rdfs:label "Automobile"@en ; ao:broaderLine ao:PropertyAndCasualty .
ao:PersonalAuto a ao:LineOfBusiness ; rdfs:label "Personal automobile"@en ; ao:broaderLine ao:Automobile ;
    skos:notation "Auto-Personal" , "personal_auto" .
ao:PrivatePassengerAuto a ao:LineOfBusiness ; rdfs:label "Private passenger automobile"@en ; ao:broaderLine ao:PersonalAuto ;
    skos:altLabel "Private passenger vehicles"@en , "PPA"@en , "PPV"@en .
ao:CommercialAuto a ao:LineOfBusiness ; rdfs:label "Commercial automobile"@en ; ao:broaderLine ao:Automobile ;
    skos:notation "Auto-Commercial" , "commercial_auto" .

ao:Property a ao:LineOfBusiness ; rdfs:label "Property"@en ; ao:broaderLine ao:PropertyAndCasualty .
ao:PersonalProperty a ao:LineOfBusiness ; rdfs:label "Personal property"@en ; ao:broaderLine ao:Property ; skos:notation "personal_property" .
ao:CommercialProperty a ao:LineOfBusiness ; rdfs:label "Commercial property"@en ; ao:broaderLine ao:Property ; skos:notation "commercial_property" .

ao:Liability a ao:LineOfBusiness ; rdfs:label "Liability"@en ; ao:broaderLine ao:PropertyAndCasualty ; skos:notation "liability" .
ao:AccidentAndSickness a ao:LineOfBusiness ; rdfs:label "Accident and sickness"@en ; ao:broaderLine ao:PropertyAndCasualty ; skos:notation "accident_sickness" .

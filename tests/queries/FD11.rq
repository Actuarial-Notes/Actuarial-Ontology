# FD11: Which terms are synonyms of [term]?
# Test case: "development technique"

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?synonym WHERE {
  ?c a skos:Concept ; skos:prefLabel|skos:altLabel ?term ; skos:prefLabel|skos:altLabel ?synonym .
  FILTER (lcase(str(?term)) = "development technique" && ?synonym != ?term)
}

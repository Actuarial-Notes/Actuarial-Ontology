# EV3: What insured-loss estimates exist for [event]?
# Test case: the Ontario and Quebec ice storm of March 2025

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?asOf ?value ?unit WHERE {
  ?o a ao:Observation ; ao:about an:ev-on-qc-ice-storm-2025 ; ao:quantityKind ao:InsuredLoss ;
     ao:numericValue ?value ; ao:asOfDate ?asOf ; ao:unit/skos:notation ?unit .
} ORDER BY ?asOf

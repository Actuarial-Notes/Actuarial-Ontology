# FG4: At which locator is [figure] stated?
# Test case: GISA's ULAE factor for accident year 2025

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?document ?edition ?locator ?url WHERE {
  an:obs-gisa-ulae-on-ay2025 ao:statedAt ?loc .
  ?loc ao:locatorText ?locator ; ao:inEdition ?ed .
  ?ed rdfs:label ?edition ; ao:sourceUrl ?url ; ao:editionOf/rdfs:label ?document .
}

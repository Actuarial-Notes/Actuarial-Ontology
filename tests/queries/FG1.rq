# FG1: What [quantity kind] did [organization] report for [period]?
# Test case: MCT ratio, Intact Insurance Company, the quarter ending 2025-12-31

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?value WHERE {
  ?o a ao:Observation ; ao:about an:intact-insurance ; ao:quantityKind ao:MCTRatio ;
     ao:provenanceStatus ao:Reported ; ao:forPeriod ?p ; ao:numericValue ?value .
  ?p ao:periodStart "2025-10-01"^^xsd:date ; ao:periodEnd "2025-12-31"^^xsd:date .
}

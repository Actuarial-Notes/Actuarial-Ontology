# WK19: Which method did [analysis] use for [step]?
# Test case: the synthetic rate indication, the last step of the ratemaking chain

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?method WHERE {
  ?app a ao:MethodApplication ; ao:partOfAnalysis syn:indication-1 ;
       ao:forStep an:chain-ratemaking-step-7 ; ao:usedMethod/rdfs:label ?method .
}

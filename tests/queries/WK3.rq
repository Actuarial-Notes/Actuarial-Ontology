# WK3: Which quantity kinds does [method] take as input?
# Test case: Bornhuetter-Ferguson Method

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?input WHERE { an:method-bornhuetter-ferguson-method a ao:Method ; ao:takesInput/rdfs:label ?input }

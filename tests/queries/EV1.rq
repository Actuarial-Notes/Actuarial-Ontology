# EV1: Which catastrophe events occurred in [jurisdiction] between [date] and [date]?
# Test case: Ontario, 2025-01-01 to 2025-12-31 (the wiki's catastrophe pages cover Ontario and Quebec, not Alberta, the case first drafted)

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?event WHERE {
  ?e a ao:CatastropheEvent ; rdfs:label ?event ; ao:startDate ?start ; ao:endDate ?end ;
     ao:inJurisdiction/ao:partOfJurisdiction* ao:CA-ON .
  FILTER (?start <= "2025-12-31"^^xsd:date && ?end >= "2025-01-01"^^xsd:date)
}

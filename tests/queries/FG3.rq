# FG3: What value of [quantity kind] does [body] prescribe for [line] in [jurisdiction], effective [date]?
# Test case: profit provision, AIRB, private passenger automobile, Alberta, 2026-10-01

PREFIX ao: <http://actuarialnotes.com/ontology/actuarial#>
PREFIX an: <http://actuarialnotes.com/data/>
PREFIX syn: <http://actuarialnotes.com/data/synthetic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?value WHERE {
  ?o ao:quantityKind ao:ProfitProvision ; ao:provenanceStatus ao:Prescribed ;
     ao:forLine ao:PrivatePassengerAuto ; ao:inJurisdiction ao:CA-AB ;
     ao:effectiveFrom "2026-10-01"^^xsd:date ; ao:numericValue ?value ;
     ao:statedAt/ao:inEdition/ao:editionOf/ao:issuedBy an:airb .
}

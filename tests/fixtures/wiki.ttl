#################################################################
#    Methods and exposure bases
#################################################################

# Concepts/Exposure Base.md, table: "Personal automobile | Earned car-years"
an:exposure-earned-car-years a ao:ExposureBase ;
    rdfs:label "Earned car-years"@en ;
    ao:wikiPage "Concepts/Exposure Base.md" .
ao:PersonalAuto ao:exposureBase an:exposure-earned-car-years .

# What each method takes and gives, as its concept page's opening states it.
# The methods themselves are declared in tools.ttl.
an:method-bornhuetter-ferguson-method
    ao:takesInput ao:ReportedClaims , ao:ExpectedClaims , ao:CumulativeDevelopmentFactor ;
    ao:produces ao:UltimateClaims ;
    ao:wikiPage "Concepts/Bornhuetter-Ferguson Method.md" .
an:method-chain-ladder-method
    ao:takesInput ao:CumulativeDevelopmentFactor ;
    ao:produces ao:UltimateClaims ;
    ao:wikiPage "Concepts/Chain Ladder Method.md" .
an:method-expected-loss-method
    ao:takesInput ao:ExpectedClaims ;
    ao:produces ao:UltimateClaims ;
    ao:wikiPage "Concepts/Expected Loss Method.md" .
an:method-benktander-method
    ao:produces ao:UltimateClaims ;
    ao:wikiPage "Concepts/Benktander Method.md" .

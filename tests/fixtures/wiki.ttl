@prefix ao: <http://actuarialnotes.com/ontology/actuarial#> .
@prefix an: <http://actuarialnotes.com/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Real records, transcribed by hand from pages of the Actuarial Notes Wiki
# at commit 58275f71. Every record names the wiki page it was read from
# (ao:wikiPage) and carries that page's fact-check status on the day.
# Nothing here is from memory: a fact the page does not state is absent.
# This file stands in for the export the wiki will generate (roadmap,
# phase 3); when that exists, this file is replaced by its output.

#################################################################
#    Organizations
#################################################################

an:osfi a ao:Organization ;
    rdfs:label "Office of the Superintendent of Financial Institutions"@en ;
    ao:authorityCovers ao:CA ;
    ao:wikiPage "Resources/Books/OSFI MCT.md" .

an:airb a ao:Organization ;
    rdfs:label "Automobile Insurance Rate Board"@en ;
    ao:authorityCovers ao:CA-AB ;
    ao:wikiPage "Resources/Regulation/AIRB Filing Guidelines (2025).md" .

an:fsra a ao:Organization ;
    rdfs:label "Financial Services Regulatory Authority of Ontario"@en ;
    ao:authorityCovers ao:CA-ON ;
    ao:wikiPage "Resources/Benchmarks/FSRA Private Passenger Automobile Loss Trend Benchmarks (2025).md" .

an:gisa a ao:Organization ;
    rdfs:label "General Insurance Statistical Agency"@en ;
    ao:wikiPage "Resources/Data/GISA AUTO1005-ON Actual Loss Ratio Exhibit (2025).md" .

an:cia a ao:Organization ;
    rdfs:label "Canadian Institute of Actuaries"@en ;
    ao:wikiPage "Resources/Books/CIA CSOP.md" .

an:catiq a ao:Organization ;
    rdfs:label "Catastrophe Indices and Quantification Inc."@en ;
    ao:wikiPage "Resources/Reports/CatIQ Ice Storm Final Loss Estimate (2026).md" .

# Insurers, named as OSFI's PC4 return names them.
an:intact-insurance a ao:Organization ;
    rdfs:label "Intact Insurance Company"@en ;
    ao:wikiPage "Resources/Data/OSFI/Property and Casualty.md" .
an:wawanesa-mutual a ao:Organization ;
    rdfs:label "The Wawanesa Mutual Insurance Company"@en ;
    ao:wikiPage "Resources/Data/OSFI/Property and Casualty.md" .
an:definity-insurance a ao:Organization ;
    rdfs:label "Definity Insurance Company"@en ;
    ao:wikiPage "Resources/Data/OSFI/Property and Casualty.md" .

#################################################################
#    Supervision and roles
#################################################################
#
#    An insurer in OSFI's PC4 return is a federally regulated insurer
#    that files its Minimum Capital Test with OSFI.

an:sup-osfi-intact a ao:Supervision ;
    ao:supervisor an:osfi ; ao:supervised an:intact-insurance ;
    ao:regulatoryDomain ao:Solvency ; ao:inJurisdiction ao:CA ;
    ao:wikiPage "Resources/Data/OSFI/Property and Casualty.md" .
an:sup-osfi-wawanesa a ao:Supervision ;
    ao:supervisor an:osfi ; ao:supervised an:wawanesa-mutual ;
    ao:regulatoryDomain ao:Solvency ; ao:inJurisdiction ao:CA ;
    ao:wikiPage "Resources/Data/OSFI/Property and Casualty.md" .
an:sup-osfi-definity a ao:Supervision ;
    ao:supervisor an:osfi ; ao:supervised an:definity-insurance ;
    ao:regulatoryDomain ao:Solvency ; ao:inJurisdiction ao:CA ;
    ao:wikiPage "Resources/Data/OSFI/Property and Casualty.md" .

# "Section 602 of the Insurance Act and the Automobile Insurance Premiums
# Regulation require insurers to obtain approval for a new or revised rating
# program", for private passenger vehicles and other than PPV.
an:role-airb-rate-approval a ao:RoleAssignment ;
    ao:heldBy an:airb ; ao:roleType ao:RateApprovalAuthorityRole ;
    ao:inJurisdiction ao:CA-AB ; ao:forLine ao:Automobile ;
    ao:wikiPage "Resources/Regulation/AIRB Filing Guidelines (2025).md" .

